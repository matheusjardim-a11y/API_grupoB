# Modelo do arquivo .env. Copie para .env, troque as senhas e NÃO envie o .env ao GitHub.

MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=alarmes_e3
MYSQL_USER=e3_alarmes
MYSQL_PASSWORD=troque-esta-senha

# Porta do computador que aponta para o MySQL (a do E3 deve ser a mesma).
# 3307 evita conflito com outro MySQL que use a 3306.
MYSQL_PORT=3307

# 127.0.0.1 = só este computador. Use 0.0.0.0 para outro computador acessar o banco.
MYSQL_BIND=127.0.0.1
